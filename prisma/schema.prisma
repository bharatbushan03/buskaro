// BusKaro Database Schema
// 
// This is the Prisma schema file for the BusKaro bus tracking system.
// After making changes, run:
//   npx prisma migrate dev --name <migration_name>
//   npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - Base authentication entity
model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  phone         String?    @unique
  passwordHash  String     @map("password_hash")
  role          UserRole
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  lastLoginAt   DateTime?  @map("last_login_at")

  // Relations
  student       Student?
  driver        Driver?
  admin         Admin?
  notifications Notification[]
  sessions      Session[]
  auditLogs     AuditLog[]

  @@map("users")
}

enum UserRole {
  STUDENT
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

// Student profile
model Student {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  studentId     String   @unique @map("student_id") // College ID
  name          String
  department    String
  semester      Int
  rollNumber    String   @map("roll_number")
  busId         String?  @map("bus_id") @db.Uuid
  routeId       String?  @map("route_id") @db.Uuid
  pickupPointId String?  @map("pickup_point_id") @db.Uuid
  parentName    String?  @map("parent_name")
  parentPhone   String?  @map("parent_phone")
  address       String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bus            Bus?            @relation(fields: [busId], references: [id])
  route          Route?          @relation(fields: [routeId], references: [id])
  pickupPoint    PickupPoint?    @relation(fields: [pickupPointId], references: [id])
  attendances    Attendance[]
  payments       Payment[]
  pickupPins     PickupPin[]
  pickupRequests PickupRequest[]

  @@map("students")
}

// Driver profile
model Driver {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  name             String
  licenseNumber    String   @map("license_number")
  licenseExpiry    DateTime @map("license_expiry")
  emergencyContact String?  @map("emergency_contact")
  isOnDuty         Boolean  @default(false) @map("is_on_duty")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bus            Bus?            @relation("AssignedBus")
  pickupRequests PickupRequest[]

  @@map("drivers")
}

// Admin profile
model Admin {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @unique @map("user_id") @db.Uuid
  name        String
  department  String?
  permissions AdminPermission[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

enum AdminPermission {
  MANAGE_USERS
  MANAGE_BUSES
  MANAGE_ROUTES
  MANAGE_PAYMENTS
  VIEW_ANALYTICS
  MANAGE_NOTIFICATIONS
  SYSTEM_SETTINGS
}

// Bus fleet
model Bus {
  id                 String    @id @default(uuid()) @db.Uuid
  registrationNumber String    @unique @map("registration_number")
  model              String
  manufacturer       String
  year               Int
  type               BusType   @default(STANDARD)
  capacity           Int
  status             BusStatus @default(ACTIVE)
  currentDriverId    String?   @unique @map("current_driver_id") @db.Uuid
  currentRouteId     String?   @map("current_route_id") @db.Uuid
  gpsDeviceId        String?   @map("gps_device_id")
  fuelType           String    @map("fuel_type")
  insuranceExpiry    DateTime  @map("insurance_expiry")
  permitExpiry       DateTime  @map("permit_expiry")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Current location (stored in Redis for real-time, here for reference)
  currentLat     Float?    @map("current_lat")
  currentLng     Float?    @map("current_lng")
  lastLocationAt DateTime? @map("last_location_at")

  // Relations
  driver         Driver?           @relation("AssignedBus", fields: [currentDriverId], references: [id])
  route          Route?            @relation(fields: [currentRouteId], references: [id])
  students       Student[]
  attendances    Attendance[]
  locations      LocationHistory[]
  pickupRequests PickupRequest[]

  @@map("buses")
}

enum BusType {
  STANDARD
  AC
  LUXURY
  MINI
}

enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
}

// Bus location history
model LocationHistory {
  id    String @id @default(uuid()) @db.Uuid
  busId String @map("bus_id") @db.Uuid

  // Location coordinates
  latitude  Float
  longitude Float
  accuracy  Float?
  heading   Float?
  speed     Float?
  altitude  Float?

  // Metadata
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  bus Bus @relation(fields: [busId], references: [id], onDelete: Cascade)

  // Indexes for fast queries
  @@index([busId, recordedAt])
  @@index([latitude, longitude])
  @@map("location_history")
}

// Routes with GeoJSON path support
model Route {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  routeNumber   String  @unique @map("route_number")
  description   String?
  startLocation String  @map("start_location")
  endLocation   String  @map("end_location")

  // GeoJSON path for the route
  pathGeoJson Json? @map("path_geojson")

  totalDistance     Float       @map("total_distance") // km
  estimatedDuration Int         @map("estimated_duration") // minutes
  status            RouteStatus @default(ACTIVE)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  // Relations
  buses         Bus[]
  pickupPoints  PickupPoint[]
  students      Student[]
  attendances   Attendance[]
  feeStructures BusFeeStructure[]

  @@map("routes")
}

enum RouteStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
}

// Pickup points
model PickupPoint {
  id                   String   @id @default(uuid()) @db.Uuid
  routeId              String   @map("route_id") @db.Uuid
  name                 String
  address              String
  latitude             Float
  longitude            Float
  landmark             String?
  arrivalTime          String   @map("arrival_time") // HH:mm format
  sequenceOrder        Int      @map("sequence_order")
  estimatedWaitMinutes Int      @default(2) @map("estimated_wait_minutes")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  route       Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students    Student[]
  pins        PickupPin[]
  attendances Attendance[]

  @@index([routeId, sequenceOrder])
  @@map("pickup_points")
}

// Pickup PINs for attendance verification with geolocation
model PickupPin {
  id            String          @id @default(uuid()) @db.Uuid
  pickupPointId String          @map("pickup_point_id") @db.Uuid
  studentId     String?         @map("student_id") @db.Uuid // Optional: specific student assignment
  code          String          @unique
  status        PickupPinStatus @default(ACTIVE)

  // Geolocation
  latitude  Float
  longitude Float
  accuracy  Float? // GPS accuracy in meters

  // Validity
  validFrom DateTime  @default(now()) @map("valid_from")
  expiresAt DateTime? @map("expires_at")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  pickupPoint PickupPoint @relation(fields: [pickupPointId], references: [id], onDelete: Cascade)
  student     Student?    @relation(fields: [studentId], references: [id])

  @@index([code])
  @@index([pickupPointId, status])
  @@map("pickup_pins")
}

enum PickupPinStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

// Dynamic pickup requests (Uber-style)
model PickupRequest {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid

  // Location (Geo point)
  latitude  Float
  longitude Float
  address   String? // Optional address description
  accuracy  Float? // GPS accuracy in meters

  // Status tracking
  status PickupRequestStatus @default(PENDING)

  // Assignment
  driverId String? @map("driver_id") @db.Uuid
  busId    String? @map("bus_id") @db.Uuid

  // Timing
  requestedAt DateTime  @default(now()) @map("requested_at")
  expiresAt   DateTime  @map("expires_at") // 30 min TTL
  completedAt DateTime? @map("completed_at")

  // Metadata
  notes    String? // Student notes for driver
  priority Int     @default(0) // For future prioritization

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  driver  Driver? @relation(fields: [driverId], references: [id])
  bus     Bus?    @relation(fields: [busId], references: [id])

  // Indexes for geo queries
  @@index([studentId, status])
  @@index([driverId, status])
  @@index([status, expiresAt])
  @@index([latitude, longitude]) // For geo queries
  @@map("pickup_requests")
}

enum PickupRequestStatus {
  PENDING
  ACCEPTED
  COMPLETED
  EXPIRED
  CANCELLED
}

// Trip management for driver operations
model Trip {
  id          String      @id @default(uuid()) @db.Uuid
  driverId    String      @map("driver_id") @db.Uuid
  busId       String      @map("bus_id") @db.Uuid
  routeId     String      @map("route_id") @db.Uuid

  // Timing
  startTime   DateTime    @default(now()) @map("start_time")
  endTime     DateTime?   @map("end_time")

  // Status
  status      TripStatus  @default(IN_PROGRESS)

  // Location tracking
  startLat    Float?      @map("start_lat")
  startLng    Float?      @map("start_lng")
  endLat      Float?      @map("end_lat")
  endLng      Float?      @map("end_lng")

  // Metadata
  distanceKm  Float?      @map("distance_km")
  notes       String?

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  driver      Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  bus         Bus         @relation(fields: [busId], references: [id])
  route       Route       @relation(fields: [routeId], references: [id])

  @@index([driverId, status])
  @@index([busId, status])
  @@index([startTime])
  @@map("trips")
}

enum TripStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

// Attendance records
model Attendance {
  id               String           @id @default(uuid()) @db.Uuid
  studentId        String           @map("student_id") @db.Uuid
  busId            String           @map("bus_id") @db.Uuid
  routeId          String           @map("route_id") @db.Uuid
  pickupPointId    String?          @map("pickup_point_id") @db.Uuid
  date             DateTime         @db.Date
  status           AttendanceStatus
  boardingTime     DateTime?        @map("boarding_time")
  alightingTime    DateTime?        @map("alighting_time")
  verifiedByPin    Boolean          @default(false) @map("verified_by_pin")
  verifiedByNfc    Boolean          @default(false) @map("verified_by_nfc")
  verifiedByQr     Boolean          @default(false) @map("verified_by_qr")
  locationLat      Float?           @map("location_lat")
  locationLng      Float?           @map("location_lng")
  locationAccuracy Float?           @map("location_accuracy")
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bus         Bus          @relation(fields: [busId], references: [id])
  route       Route        @relation(fields: [routeId], references: [id])
  pickupPoint PickupPoint? @relation(fields: [pickupPointId], references: [id])

  @@unique([studentId, date])
  @@index([busId, date])
  @@index([routeId, date])
  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// Payments with Razorpay integration
model Payment {
  id        String         @id @default(uuid()) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  amount    Float
  currency  String         @default("INR")
  status    PaymentStatus  @default(PENDING)
  method    PaymentMethod?

  // Razorpay fields
  razorpayOrderId   String? @unique @map("razorpay_order_id")
  razorpayPaymentId String? @unique @map("razorpay_payment_id")
  razorpaySignature String? @map("razorpay_signature")

  // Fallback/generic transaction ID
  transactionId String? @map("transaction_id")

  // Payment details
  description    String
  feeStructureId String? @map("fee_structure_id") @db.Uuid
  metadata       Json?

  // Receipt and invoice
  receiptNumber String? @map("receipt_number")
  invoiceUrl    String? @map("invoice_url")

  // Timestamps
  paidAt     DateTime? @map("paid_at")
  failedAt   DateTime? @map("failed_at")
  refundedAt DateTime? @map("refunded_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NET_BANKING
  WALLET
}

// Bus fee structure
model BusFeeStructure {
  id            String   @id @default(uuid()) @db.Uuid
  routeId       String   @map("route_id") @db.Uuid
  amount        Float
  currency      String   @default("INR")
  academicYear  String   @map("academic_year")
  semester      Int
  description   String?
  dueDate       DateTime @map("due_date")
  lateFeePerDay Float    @default(0) @map("late_fee_per_day")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("bus_fee_structures")
}

// Notifications
model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  type        NotificationType
  title       String
  body        String
  data        Json?
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  sentAt      DateTime?           @map("sent_at")
  deliveredAt DateTime?           @map("delivered_at")
  readAt      DateTime?           @map("read_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  BUS_ARRIVING
  BUS_DELAYED
  BUS_CANCELLED
  ROUTE_CHANGE
  ATTENDANCE_MARKED
  PAYMENT_DUE
  PAYMENT_RECEIVED
  EMERGENCY_ALERT
  GENERAL_ANNOUNCEMENT
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// Sessions for tracking active logins
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Audit Log for tracking all system actions
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  // Action details
  action     AuditAction
  entityType String      @map("entity_type") // e.g., "Bus", "Student", "Payment"
  entityId   String?     @map("entity_id") @db.Uuid

  // User who performed the action
  userId   String?   @map("user_id") @db.Uuid
  userRole UserRole? @map("user_role")

  // Change tracking
  oldValues Json? @map("old_values")
  newValues Json? @map("new_values")
  metadata  Json?

  // Request context
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  requestId String? @map("request_id")

  // Geolocation (if applicable)
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  EXPORT
  IMPORT
  PAYMENT_INITIATED
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  LOCATION_UPDATED
  ATTENDANCE_MARKED
  EMERGENCY_TRIGGERED
}
