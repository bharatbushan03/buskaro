# ==========================================
# BusKaro Production Environment Configuration
# ==========================================
# Copy this file to .env.production and fill in real values
# NEVER commit .env.production to git!

# ==========================================
# GLOBAL
# ==========================================
NODE_ENV=production
COMPOSE_PROJECT_NAME=buskaro

# ==========================================
# BACKEND (Node.js API)
# ==========================================
# Server
BACKEND_PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=buskaro
DB_PASSWORD=change_this_in_production
DB_NAME=buskaro
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# Redis (Caching & Socket.IO)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# JWT (Generate with: openssl rand -base64 32)
JWT_SECRET=generate_strong_secret_here
JWT_EXPIRES_IN=7d

# Socket.IO
SOCKET_CORS_ORIGIN=*

# ==========================================
# PAYMENTS (Razorpay)
# ==========================================
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_WEBHOOK_SECRET=webhook_secret_here

# ==========================================
# MAPS & LOCATION
# ==========================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# AI_MAP_SERVICE_API_KEY=optional_ai_service_key

# ==========================================
# NOTIFICATIONS
# ==========================================
# SMS (Twilio)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_number

# Email (SendGrid/AWS SES)
# EMAIL_SERVICE_PROVIDER=sendgrid
# SENDGRID_API_KEY=your_sendgrid_api_key
# FROM_EMAIL=noreply@buskaro.com

# Push Notifications (Firebase)
# FIREBASE_SERVER_KEY=your_firebase_key

# ==========================================
# WEB ADMIN (React Frontend)
# ==========================================
VITE_API_URL=https://api.buskaro.com
VITE_SOCKET_URL=wss://api.buskaro.com

# ==========================================
# MOBILE APP (Expo)
# ==========================================
EXPO_PUBLIC_API_URL=https://api.buskaro.com
EXPO_PUBLIC_SOCKET_URL=wss://api.buskaro.com
EXPO_PUBLIC_GOOGLE_MAPS_KEY=${GOOGLE_MAPS_API_KEY}

# ==========================================
# MONITORING
# ==========================================
# Prometheus & Grafana
PROMETHEUS_RETENTION_DAYS=15
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_default_password

# Sentry Error Tracking
# SENTRY_DSN=your_sentry_dsn
# SENTRY_ENVIRONMENT=production

# ==========================================
# SECURITY
# ==========================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ALLOWED_ORIGINS=https://admin.buskaro.com,https://buskaro.com

# SSL/TLS
SSL_CERT_PATH=/etc/ssl/certs/buskaro.crt
SSL_KEY_PATH=/etc/ssl/private/buskaro.key

# ==========================================
# CLOUD PROVIDER (AWS)
# ==========================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET_NAME=buskaro-assets
# CLOUDFRONT_DOMAIN=your_cloudfront_domain

# EKS (Kubernetes)
# EKS_CLUSTER_NAME=buskaro-production
# EKS_CLUSTER_ARN=arn:aws:eks:region:account:cluster/name

# RDS (PostgreSQL)
# RDS_ENDPOINT=your_rds_endpoint
# RDS_PORT=5432

# ElastiCache (Redis)
# ELASTICACHE_ENDPOINT=your_redis_endpoint
# ELASTICACHE_PORT=6379

# ==========================================
# BACKUP & MAINTENANCE
# ==========================================
# Database backup schedule
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Log retention
LOG_RETENTION_DAYS=14
